# Copy this file to .env in the repository root. Never commit credentials.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/aquashield
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_RETRY_INTERVAL_MS=5000
CORS_ORIGIN=http://localhost:5173

# Vite exposes only VITE_* variables to the browser. Never prefix secrets with VITE_.
# Use /api with the development proxy, or an absolute API URL for hosted builds.
VITE_API_BASE_URL=/api
# Leave empty to proxy to http://127.0.0.1:<PORT>.
API_PROXY_TARGET=

# Reserved for later phases. These do not enable any Phase 1 functionality.
JWT_SECRET=
REDIS_URL=
AI_PROVIDER=bedrock
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=
STRANDS_MODE=true
DEMO_AI_MODE=true
MAPBOX_TOKEN=

# Optional read-only MongoDB integration test target; defaults to MONGODB_URI.
MONGODB_TEST_URI=

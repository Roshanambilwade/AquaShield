# Copy this file to .env in the repository root. Never commit credentials.
NODE_ENV=development
DEMONSTRATION_MODE=false
DEMO_SEED_ENABLED=false
# Dedicated database on the configured MongoDB deployment; never production.
DEMO_DATABASE_NAME=aquashield_demo
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/aquashield
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_RETRY_INTERVAL_MS=5000
# Exact, comma-separated origins. Production must set its own explicit list.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Vite exposes only VITE_* variables to the browser. Never prefix secrets with VITE_.
# Use /api with the development proxy, or an absolute API URL for hosted builds.
VITE_API_BASE_URL=/api
# Leave empty to proxy to http://127.0.0.1:<PORT>.
API_PROXY_TARGET=

# Phase 4: expiring opaque admin sessions; no default account/password.
# Existing name retained: session lifetime for ADMIN, OPERATOR and CITIZEN (0.1–24 hours).
ADMIN_SESSION_HOURS=8
# Used only by npm run admin:create; never exposed to Vite. Password: at least 12 characters.
# Development may leave these empty to generate local credentials in .local/admin-access.json.
# Production provisioning requires an explicit email and password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Phase 5: backend-only. Demo mode makes NO provider calls; production rejects demo.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.8-flash
DEMO_AI_MODE=false
AI_TIMEOUT_MS=60000
# Overall AI deadline above includes attempts and backoff. A shorter per-attempt
# timeout may be configured; it is always capped by the remaining overall budget.
AI_ATTEMPT_TIMEOUT_MS=60000
AI_MAX_RETRIES=1
AI_RETRY_BASE_MS=500
AI_RETRY_MAX_DELAY_MS=5000
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_RESET_MS=30000
AI_MAX_CONCURRENT=2
AI_FAIRNESS_MAX_ADJUSTMENT=15

# Reserved for later phases; AWS/Bedrock are not needed for Gemini.
JWT_SECRET=
REDIS_URL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=
MAPBOX_TOKEN=

# Optional MongoDB test server URI; report tests use a unique temporary database.
MONGODB_TEST_URI=

# Phase 3 deterministic detection and scoring. Weights are JSON and sum to 100.
CLUSTER_RADIUS_KM=1
CLUSTER_TIME_WINDOW_HOURS=6
CLUSTER_ACTIVE_HOURS=24
CLUSTER_MIN_REPORTS=3
DUPLICATE_RADIUS_KM=0.1
DUPLICATE_WINDOW_HOURS=6
SUSPICIOUS_SPEED_KMH=200
DURATION_CONFLICT_HOURS=6
CONFIDENCE_INDEPENDENT_TARGET=10
CONFIDENCE_CONFIRMED_THRESHOLD=60
CONFIDENCE_WEIGHTS={"consistency":35,"geographic":25,"independent":20,"infrastructure":10,"time":10}
SEVERITY_WEIGHTS={"duration":25,"population":20,"waterLevel":20,"environmental":15,"vulnerability":10,"confidence":10}
SEVERITY_THRESHOLDS={"medium":30,"high":60,"critical":80}
SEVERITY_DURATION_MAX_HOURS=25
SEVERITY_POPULATION_MAX=750
SEVERITY_TEMPERATURE_MIN_C=25
SEVERITY_TEMPERATURE_MAX_C=44
SEVERITY_VULNERABILITY_MAX_RATIO=0.25
# Modeling assumption, not a measured reporting rate. Exposed in estimate evidence.
POPULATION_REPORT_COVERAGE=0.25

# Phase 6: availability must have been confirmed within this many hours (0.1–168).
OPERATIONS_STALE_HOURS=12

# Public live aggregates (fictional demo evidence is exempt).
PUBLIC_MIN_HOUSEHOLDS=5
PUBLIC_LOCATION_GRID_DEGREES=0.02
# Successful detection reuse; submissions/seeding/explicit detection invalidate it.
DETECTION_REFRESH_MS=15000
# MONGODB_TEST_DB_NAME is generated by browser tests; never set it for normal use.
# Phase 7: backend-only routing and OTP settings. No paid routing required.
ROUTING_BASE_URL=
ROUTING_AVERAGE_SPEED_KPH=25
ROUTING_TIMEOUT_MS=5000
DELIVERY_OTP_TTL_SECONDS=300
DELIVERY_OTP_MAX_ATTEMPTS=5
DELIVERY_OTP_REISSUE_SECONDS=60
# Phase 8: deterministic report-activity prediction. No Gemini key required.
# Window/horizon may be 3, 6 or 12 hours; default history is twelve complete windows.
PREDICTION_WINDOW_HOURS=6
PREDICTION_HISTORY_WINDOWS=12
PREDICTION_MIN_REPORTS=18
PREDICTION_MIN_REPORTERS=6
PREDICTION_STALE_HOURS=12
PREDICTION_MODERATE_THRESHOLD=25
PREDICTION_HIGH_THRESHOLD=50
PREDICTION_CRITICAL_THRESHOLD=75

# Template only. Inject real values through backend runtime secrets/settings.
# Do not upload this file to Amplify or replace your local .env.
NODE_ENV=production
# Generic local/container port. App Runner reserves PORT: set its image Port to
# 5000 in service configuration instead of adding a custom PORT variable.
PORT=5000
MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER.mongodb.net/aquashield?retryWrites=true&w=majority
CORS_ORIGIN=https://REPLACE_FRONTEND.amplifyapp.com
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_RETRY_INTERVAL_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
DEMONSTRATION_MODE=false
DEMO_SEED_ENABLED=false
DEMO_AI_MODE=false
FORECAST_DEMO_ENABLED=false
SIMULATION_ENABLED=false
SIMULATION_PREPARE_ENABLED=false
AI_PROVIDER=gemini
# Optional backend-only values for real AI advice; numerical services need neither.
GEMINI_API_KEY=
GEMINI_MODEL_ID=
